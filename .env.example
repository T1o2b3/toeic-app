# Mẫu biến môi trường. Copy thành .env rồi điền giá trị thật.
# .env nằm trong .gitignore; .env.example thì được commit (không chứa bí mật).
GEMINI_API_KEY=

# Đồng bộ Supabase (M5). Thiếu hai biến này thì app vẫn chạy, chỉ là không đồng bộ.
# Lấy ở Supabase → Project Settings → API. CHỈ dùng anon/public key.
# TUYỆT ĐỐI không đưa service_role key vào đây: file .env được nạp vào frontend qua Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
